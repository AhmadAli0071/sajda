<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_streak_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sajda_widget_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="STREAK"
        android:textColor="#8FD4B4"
        android:textSize="9sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_streak_days"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="days"
        android:textColor="#8FD4B4"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/widget_streak_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="○ ○ ○ ○ ○"
        android:textColor="#E8C87A"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_streak_today"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Today 0/5"
        android:textColor="#8FD4B4"
        android:textSize="10sp" />
</LinearLayout>
